# --- Backend ---
NODE_ENV=development
PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# --- MySQL (XAMPP defaults) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=routeview

# --- ML inference service (FastAPI) ---
ML_SERVICE_URL=http://127.0.0.1:8000

# --- OpenRouter (optional; server-side only) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_APP_NAME=RouteView
OPENROUTER_APP_URL=http://localhost:3000
AI_REQUEST_TIMEOUT_MS=25000
AI_RATE_LIMIT_PER_MIN=20

# --- Frontend (NEXT_PUBLIC_ prefix) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png